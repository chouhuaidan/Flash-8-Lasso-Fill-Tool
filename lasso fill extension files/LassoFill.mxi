<?xml version="1.0" encoding="UTF-8"?>

<macromedia-extension
    name="LassoFill"
    version="1.0.0"
    type="flash">

    <author name="Austin Liu"/>

    <description>
        <![CDATA[
        A custom Lasso Fill tool for Adobe Flash 8.
        ]]>
    </description>

    <ui-access>
        <![CDATA[
        LassoFill tool
        ]]>
    </ui-access>

    <products>
        <product
            name="Flash"
            version="8.0"
            primary="true"/>
    </products>

    <files>

        <file
            source="LassoFill.jsfl"
            destination="$flash/Configuration/Tools"
            file-type="tool"/>

        <file
            source="LassoFill.xml"
            destination="$flash/Configuration/Tools"
            file-type="tool"/>

        <file
            source="LassoFill.png"
            destination="$flash/Configuration/Tools"
            file-type="ordinary"/>

        <file
            source="toolConfig.xml"
            destination="$flash/Configuration/Tools"
            file-type="ordinary"/>

    </files>

</macromedia-extension>